{
  "manifest_version": 3,
  "name": "xpsimulator new tab",
  "version": "1.1.1",
  "description": "Transforms your browser new tab into a full Windows XP simulator. Unblocks iframes, provides classic web browsing, custom embedded apps, and full desktop experience.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Windows XP Simulator Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "declarativeNetRequest",
    "scripting",
    "cookies",
    "bookmarks",
    "topSites",
    "clipboardRead",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_unframe",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "*://runtime/*",
        "*://*.runtime/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "web-viewport.css"
      ]
    },
    {
      "matches": [
        "*://copy.sh/*",
        "*://*.copy.sh/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "v86.css"
      ]
    },
    {
      "matches": [
        "*://pcjs.org/*",
        "*://*.pcjs.org/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "pcjs.css"
      ]
    },
    {
      "matches": [
        "*://distrosea.com/*",
        "*://*.distrosea.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "distrosea.css"
      ]
    },
    {
      "matches": [
        "*://*.online/*",
        "*://*.fun/*",
        "*://*.lol/*",
        "*://*.optijuegos.net/*",
        "*://all22pokemon.com/*",
        "*://*.exebrowser.com/*",
        "*://exebrowser.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "web-viewport.css"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "frame-fix.js"
      ]
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "exclude_matches": [
        "*://*.youtube.com/embed/*"
      ],
      "all_frames": true,
      "js": [
        "helpers/logger.js",
        "helpers/enums.js",
        "helpers/states.js",
        "redux/initial-setup.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "exclude_matches": [
        "*://*.youtube.com/embed/*"
      ],
      "all_frames": true,
      "js": [
        "redux/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.ma/*",
        "*://*.google.es/*",
        "*://*.google.fr/*",
        "*://*.google.co.uk/*",
        "*://*.google.de/*",
        "*://*.google.ca/*",
        "*://*.google.it/*"
      ],
      "all_frames": true,
      "js": [
        "google-classic.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "helpers/*",
        "redux/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}